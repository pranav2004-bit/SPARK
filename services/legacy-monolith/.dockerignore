# Python cache — never needed in the image
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo

# Collected static files — regenerated by entrypoint.sh on every start
staticfiles/

# Local dev databases
*.sqlite3
db.sqlite3

# Environment files — secrets must never be baked into an image
.env
.env.*
!.env.example

# Git
.git/
.gitignore

# Editor / OS noise
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# Test / coverage artefacts
.coverage
htmlcov/
.pytest_cache/
