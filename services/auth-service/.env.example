# ── Core ──────────────────────────────────────────────────────────────────────
# Django secret key — minimum 50 characters, unique per service
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=dev-only-insecure-key-replace-before-production-xxxxxxxxxxxxxxxxxxxxxxx

# Boolean — must be False in production
DEBUG=True

# Set to "production" or "development"
ENVIRONMENT=development

# Space-separated list of allowed hostnames
ALLOWED_HOSTS=localhost 127.0.0.1

# ── Database (auth_db via PgBouncer) ──────────────────────────────────────────
DB_NAME=auth_db
DB_USER=auth_db_user
DB_PASSWORD=dev_password
DB_HOST=localhost
DB_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
# JWT blacklist + cache
REDIS_URL=redis://localhost:6379/0

# ── JWT ───────────────────────────────────────────────────────────────────────
# Shared signing key — SAME value in ALL 6 services (required for cross-service JWT validation)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SIGNING_KEY=dev-jwt-signing-key-replace-before-production-xxxxxxxxxxxxxxxxxxx

# ── Sentry ────────────────────────────────────────────────────────────────────
# DSN from Sentry project dashboard — required in production, optional in dev
# Leave empty in dev to disable Sentry
SENTRY_DSN=

# ── Performance ───────────────────────────────────────────────────────────────
# Uvicorn workers = (2 × vCPU) + 1
# 1 vCPU = 3  |  2 vCPU = 5  |  4 vCPU = 9
UVICORN_WORKERS=3
