# ── Core ──────────────────────────────────────────────────────────────────────
SECRET_KEY=dev-auth-service-secret-key-replace-before-production-xxxxxxxxxxx
DEBUG=True
ENVIRONMENT=development
# In production, this MUST also include the internal Docker hostname
# "auth-service" — user-service and assessment-service call this service
# directly over the Docker network (bypassing nginx) using that hostname
# as the request Host header, e.g. "ALLOWED_HOSTS=api.example.com auth-service".
# Omitting it makes Django reject every internal call with a generic 400
# Bad Request, before the request ever reaches a view (confirmed live,
# 2026-09-16 — broke bulk student import and assessment roster lookups).
ALLOWED_HOSTS=localhost 127.0.0.1

# Shared secret for X-Service-Key header — SAME value across all services.
# Required here: authentication/core/permissions.py::IsInternalService gates
# the internal student-creation endpoint on this exact value. Leaving it
# blank doesn't just weaken the check, it makes the endpoint reject every
# caller unconditionally — IsInternalService requires a non-empty expected
# value before comparing (confirmed live, 2026-09-16 — this was blank in a
# production deployment and silently broke bulk student import with a
# generic 403, since this var was never documented in this file before).
SERVICE_KEY=dev-service-key-32-chars-minimum-ok

# ── Database (auth_db via PgBouncer) ──────────────────────────────────────────
DB_NAME=auth_db
DB_USER=auth_db_user
DB_PASSWORD=auth_dev_password_2024
DB_HOST=pgbouncer
DB_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT ───────────────────────────────────────────────────────────────────────
# SAME value across ALL 6 services — if any service has a different value, JWT validation breaks
JWT_SIGNING_KEY=dev-jwt-key-32-chars-minimum-length-ok

# ── Institution ───────────────────────────────────────────────────────────────
# UUID that identifies this college. Stamped on every account created by IT.
# Only auth-service needs this — all other services inherit it from the JWT.
INSTITUTION_ID=1470350a-1765-41d1-92b9-bf7b040ddaf9

# ── Default Credentials (auto-created on first container startup) ─────────────
# IT is the platform's bootstrapped root account — seeded from IT_EMAIL/
# IT_PASSWORD on first startup (create_default_it). IT then creates Super
# Admin, Admin, and Student accounts through the ordinary account-management
# UI, each getting one of the *_DEFAULT_PASSWORD values below on creation.
# In production: use strong unique values — never commit real passwords to git.
IT_EMAIL=ithead@gmail.com
IT_PASSWORD=000346
SUPERADMIN_DEFAULT_PASSWORD=spark@123
ADMIN_DEFAULT_PASSWORD=spark@123
STUDENT_DEFAULT_PASSWORD=ANITS@123

# ── Sentry ────────────────────────────────────────────────────────────────────
# Leave empty in dev — fill in production DSN from sentry.io project dashboard
SENTRY_DSN=

# ── Performance ───────────────────────────────────────────────────────────────
# Uvicorn workers: (2 × vCPU) + 1  →  1 vCPU=3, 2 vCPU=5, 4 vCPU=9
UVICORN_WORKERS=3
