# ── Core ──────────────────────────────────────────────────────────────────────
SECRET_KEY=dev-only-insecure-key-replace-before-production-xxxxxxxxxxxxxxxxxxxxxxx
DEBUG=True
ENVIRONMENT=development
ALLOWED_HOSTS=localhost 127.0.0.1

# ── Database (user_db via PgBouncer) ──────────────────────────────────────────
DB_NAME=user_db
DB_USER=user_db_user
DB_PASSWORD=dev_password
DB_HOST=localhost
DB_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ───────────────────────────────────────────────────────────────────────
# SAME value as auth-service — all services must share the same signing key
JWT_SIGNING_KEY=dev-jwt-signing-key-replace-before-production-xxxxxxxxxxxxxxxxxxx

# ── Sentry ────────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Performance ───────────────────────────────────────────────────────────────
UVICORN_WORKERS=3
