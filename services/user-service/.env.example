# ── Core ──────────────────────────────────────────────────────────────────────
SECRET_KEY=dev-user-service-secret-key-replace-before-production-xxxxxxxxxxx
DEBUG=True
ENVIRONMENT=development
# In production, this MUST also include the internal Docker hostname
# "user-service" — assessment-service calls this service directly over
# the Docker network (bypassing nginx) using that hostname as the request
# Host header, e.g. "ALLOWED_HOSTS=api.example.com user-service".
# Omitting it makes Django reject every internal call with a generic 400
# Bad Request, before the request ever reaches a view (confirmed live,
# 2026-09-16 — broke assessment roster lookups during assignment creation).
ALLOWED_HOSTS=localhost 127.0.0.1

# ── Database (user_db via PgBouncer) ──────────────────────────────────────────
DB_NAME=user_db
DB_USER=user_db_user
DB_PASSWORD=user_dev_password_2024
DB_HOST=pgbouncer
DB_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT ───────────────────────────────────────────────────────────────────────
# SAME value across ALL 6 services
JWT_SIGNING_KEY=dev-jwt-key-32-chars-minimum-length-ok

# ── Internal Service Authentication ───────────────────────────────────────────
# Shared secret for X-Service-Key header — SAME value across all services
SERVICE_KEY=dev-service-key-32-chars-minimum-ok

# ── Email / Dead Letter Queue Alerts ──────────────────────────────────────────
# Gmail SMTP — used to send alerts when a student delete event hits the dead-letter queue
# Leave blank in dev if email alerts are not needed
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Comma-separated list of email addresses that receive dead-letter alerts
ALERT_EMAIL_RECIPIENTS=

# ── Sentry ────────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Performance ───────────────────────────────────────────────────────────────
UVICORN_WORKERS=3
