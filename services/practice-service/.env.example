# ── Core ──────────────────────────────────────────────────────────────────────
SECRET_KEY=dev-practice-service-secret-key-replace-before-production-xxxxxxx
DEBUG=True
ENVIRONMENT=development
ALLOWED_HOSTS=localhost 127.0.0.1

# ── Database (practice_db via PgBouncer) ──────────────────────────────────────
DB_NAME=practice_db
DB_USER=practice_db_user
DB_PASSWORD=practice_dev_password_2024
DB_HOST=pgbouncer
DB_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT ───────────────────────────────────────────────────────────────────────
# SAME value across ALL 6 services
JWT_SIGNING_KEY=dev-jwt-key-32-chars-minimum-length-ok

# ── Storage (AWS S3) ────────────────────────────────────────────────────────
# Real AWS S3 — used for local dev too, not just production, so the real
# integration is proven now rather than only simulated against MinIO's
# S3-compatible-but-not-identical behavior. Get AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY from IAM user spark-app-s3-user's own access key
# (never commit real values here — this file only ever holds placeholders).
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
AWS_DEFAULT_REGION=ap-south-2
AWS_STORAGE_BUCKET_NAME=spark-app-media-2026
AWS_S3_CDN_DOMAIN=spark-app-media-2026.s3.ap-south-2.amazonaws.com

# ── ClamAV (malware scanning of question/explanation images) ──────────────────
# Scanned synchronously at question-PATCH time (no worker in this service).
# Leave CLAMAV_HOST blank to disable scanning — image PATCHes then fail
# closed with a 503 rather than silently skipping the scan.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ── Sentry ────────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Performance ───────────────────────────────────────────────────────────────
UVICORN_WORKERS=3

# ── Content bank (LIVETRACKER4.md Part 1) ───────────────────────────────────
# Off by default. When False, /api/practice/content/ returns 404.
# CONTENT_BANK_ENABLED=False
# CONTENT_OPTION_MIN=2
# CONTENT_OPTION_MAX=6
# CONTENT_QUESTION_TEXT_MAX=2000
# CONTENT_OPTION_TEXT_MAX=500
# CONTENT_EXPLANATION_MAX=2000
# CONTENT_NODE_NAME_MAX=200
# CONTENT_IMAGE_ALT_TEXT_MAX=300
# Cache lifetime for content list responses (seconds). Writes invalidate immediately.
# CONTENT_CACHE_TTL_SECONDS=60
# Timeout (seconds) for content image S3 calls; a timeout returns 503 and keeps the object.
# CONTENT_S3_TIMEOUT_SECONDS=5
