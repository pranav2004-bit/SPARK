# ── Core ──────────────────────────────────────────────────────────────────────
SECRET_KEY=dev-practice-service-secret-key-replace-before-production-xxxxxxx
DEBUG=True
ENVIRONMENT=development
ALLOWED_HOSTS=localhost 127.0.0.1

# ── Database (practice_db via PgBouncer) ──────────────────────────────────────
DB_NAME=practice_db
DB_USER=practice_db_user
DB_PASSWORD=practice_dev_password_2024
DB_HOST=pgbouncer
DB_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT ───────────────────────────────────────────────────────────────────────
# SAME value across ALL 6 services
JWT_SIGNING_KEY=dev-jwt-key-32-chars-minimum-length-ok

# ── Storage (MinIO in dev / Cloudflare R2 in production) ──────────────────────
# Dev values below use MinIO running inside Docker (via minio service)
# Production: replace with real Cloudflare R2 credentials from r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET_NAME=spark
R2_ENDPOINT_URL=http://minio:9000
R2_PUBLIC_ENDPOINT_URL=http://localhost:9002
R2_CDN_DOMAIN=localhost:9002/spark

# ── ClamAV (malware scanning of question/explanation images) ──────────────────
# Scanned synchronously at question-PATCH time (no worker in this service).
# Leave CLAMAV_HOST blank to disable scanning — image PATCHes then fail
# closed with a 503 rather than silently skipping the scan.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ── Sentry ────────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Performance ───────────────────────────────────────────────────────────────
UVICORN_WORKERS=3
