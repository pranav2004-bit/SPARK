# ── Core ──────────────────────────────────────────────────────────────────────
SECRET_KEY=dev-only-insecure-key-replace-before-production-xxxxxxxxxxxxxxxxxxxxxxx
DEBUG=True
ENVIRONMENT=development
ALLOWED_HOSTS=localhost 127.0.0.1

# ── Database (notification_db via PgBouncer) ──────────────────────────────────
DB_NAME=notification_db
DB_USER=notification_db_user
DB_PASSWORD=dev_password
DB_HOST=localhost
DB_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SIGNING_KEY=dev-jwt-signing-key-replace-before-production-xxxxxxxxxxxxxxxxxxx

# ── Internal Service Authentication ───────────────────────────────────────────
# Shared secret for X-Service-Key header on internal endpoints
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# SAME value in all services that call internal endpoints
SERVICE_KEY=dev-service-key-replace-before-production-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Sentry ────────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Performance ───────────────────────────────────────────────────────────────
UVICORN_WORKERS=3
