# ── Core ──────────────────────────────────────────────────────────────────────
SECRET_KEY=dev-notification-service-secret-key-replace-before-production-xxx
DEBUG=True
ENVIRONMENT=development
ALLOWED_HOSTS=localhost 127.0.0.1

# ── Database (notification_db via PgBouncer) ──────────────────────────────────
DB_NAME=notification_db
DB_USER=notification_db_user
DB_PASSWORD=notification_dev_password_2024
DB_HOST=pgbouncer
DB_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT ───────────────────────────────────────────────────────────────────────
# SAME value across ALL 6 services
JWT_SIGNING_KEY=dev-jwt-key-32-chars-minimum-length-ok

# ── Internal Service Authentication ───────────────────────────────────────────
# Shared secret for X-Service-Key header — SAME value across all services
SERVICE_KEY=dev-service-key-32-chars-minimum-ok

# ── Sentry ────────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Performance ───────────────────────────────────────────────────────────────
UVICORN_WORKERS=3
