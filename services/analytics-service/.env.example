# ── Core ──────────────────────────────────────────────────────────────────────
SECRET_KEY=dev-only-insecure-key-replace-before-production-xxxxxxxxxxxxxxxxxxxxxxx
DEBUG=True
ENVIRONMENT=development
ALLOWED_HOSTS=localhost 127.0.0.1

# ── Database (analytics_db via PgBouncer) ─────────────────────────────────────
DB_NAME=analytics_db
DB_USER=analytics_db_user
DB_PASSWORD=dev_password
DB_HOST=localhost
DB_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SIGNING_KEY=dev-jwt-signing-key-replace-before-production-xxxxxxxxxxxxxxxxxxx

# ── Internal Service Authentication ───────────────────────────────────────────
SERVICE_KEY=dev-service-key-replace-before-production-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Read Replica (optional — connect when replica is provisioned) ──────────────
# Leave empty to use the primary database for all queries
DATABASE_REPLICA_URL=

# ── Sentry ────────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Performance ───────────────────────────────────────────────────────────────
UVICORN_WORKERS=3
