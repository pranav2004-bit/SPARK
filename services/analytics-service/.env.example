# ── Core ──────────────────────────────────────────────────────────────────────
SECRET_KEY=dev-analytics-service-secret-key-replace-before-production-xxxxxx
DEBUG=True
ENVIRONMENT=development
ALLOWED_HOSTS=localhost 127.0.0.1

# ── Database (analytics_db via PgBouncer) ─────────────────────────────────────
DB_NAME=analytics_db
DB_USER=analytics_db_user
DB_PASSWORD=analytics_dev_password_2024
DB_HOST=pgbouncer
DB_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT ───────────────────────────────────────────────────────────────────────
# SAME value across ALL 6 services
JWT_SIGNING_KEY=dev-jwt-key-32-chars-minimum-length-ok

# ── Internal Service Authentication ───────────────────────────────────────────
# Shared secret for X-Service-Key header — SAME value across all services
SERVICE_KEY=dev-service-key-32-chars-minimum-ok

# ── Read Replica (optional) ───────────────────────────────────────────────────
# Leave empty — connects to primary DB for all queries
DATABASE_REPLICA_URL=

# ── Sentry ────────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Performance ───────────────────────────────────────────────────────────────
UVICORN_WORKERS=3
