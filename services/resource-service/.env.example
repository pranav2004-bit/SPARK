# ── Core ──────────────────────────────────────────────────────────────────────
SECRET_KEY=dev-resource-service-secret-key-replace-before-production-xxxxxxx
DEBUG=True
ENVIRONMENT=development
ALLOWED_HOSTS=localhost 127.0.0.1

# ── Database (resource_db via PgBouncer) ──────────────────────────────────────
DB_NAME=resource_db
DB_USER=resource_db_user
DB_PASSWORD=resource_dev_password_2024
DB_HOST=pgbouncer
DB_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT ───────────────────────────────────────────────────────────────────────
# SAME value across ALL 6 services
JWT_SIGNING_KEY=dev-jwt-key-32-chars-minimum-length-ok

# ── Storage (MinIO in dev / Cloudflare R2 in production) ──────────────────────
# Dev values below use MinIO running inside Docker (via minio service)
# Production: replace with real Cloudflare R2 credentials from r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET_NAME=spark
R2_ENDPOINT_URL=http://minio:9000
R2_PUBLIC_ENDPOINT_URL=http://localhost:9002
R2_CDN_DOMAIN=localhost:9002/spark

# ── ClamAV (malware scanning of confirmed file uploads) ────────────────────────
# Points at the `clamav` service in docker-compose. Leave CLAMAV_HOST blank to
# disable scanning (uploads then stay scan_status="pending" indefinitely and
# never become visible to students) — only do this if you know what you're doing.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ── Sentry ────────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Performance ───────────────────────────────────────────────────────────────
UVICORN_WORKERS=3
