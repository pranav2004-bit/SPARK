# ── Core ──────────────────────────────────────────────────────────────────────
SECRET_KEY=dev-resource-service-secret-key-replace-before-production-xxxxxxx
DEBUG=True
ENVIRONMENT=development
ALLOWED_HOSTS=localhost 127.0.0.1

# ── Database (resource_db via PgBouncer) ──────────────────────────────────────
DB_NAME=resource_db
DB_USER=resource_db_user
DB_PASSWORD=resource_dev_password_2024
DB_HOST=pgbouncer
DB_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT ───────────────────────────────────────────────────────────────────────
# SAME value across ALL 6 services
JWT_SIGNING_KEY=dev-jwt-key-32-chars-minimum-length-ok

# ── Storage (AWS S3) ────────────────────────────────────────────────────────
# Real AWS S3 — used for local dev too, not just production, so the real
# integration is proven now rather than only simulated against MinIO's
# S3-compatible-but-not-identical behavior. Get AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY from IAM user spark-app-s3-user's own access key
# (never commit real values here — this file only ever holds placeholders).
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
AWS_DEFAULT_REGION=ap-south-2
AWS_STORAGE_BUCKET_NAME=spark-app-media-2026
AWS_S3_CDN_DOMAIN=spark-app-media-2026.s3.ap-south-2.amazonaws.com

# ── ClamAV (malware scanning of confirmed file uploads) ────────────────────────
# Points at the `clamav` service in docker-compose. Leave CLAMAV_HOST blank to
# disable scanning (uploads then stay scan_status="pending" indefinitely and
# never become visible to students) — only do this if you know what you're doing.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ── Sentry ────────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Performance ───────────────────────────────────────────────────────────────
UVICORN_WORKERS=3
