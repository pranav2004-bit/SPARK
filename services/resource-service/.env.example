# ── Core ──────────────────────────────────────────────────────────────────────
SECRET_KEY=dev-only-insecure-key-replace-before-production-xxxxxxxxxxxxxxxxxxxxxxx
DEBUG=True
ENVIRONMENT=development
ALLOWED_HOSTS=localhost 127.0.0.1

# ── Database (resource_db via PgBouncer) ──────────────────────────────────────
DB_NAME=resource_db
DB_USER=resource_db_user
DB_PASSWORD=dev_password
DB_HOST=localhost
DB_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SIGNING_KEY=dev-jwt-signing-key-replace-before-production-xxxxxxxxxxxxxxxxxxx

# ── Cloudflare R2 / MinIO ─────────────────────────────────────────────────────
# R2_ACCOUNT_ID: Cloudflare dashboard → R2 overview (right sidebar)
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY: R2 → Manage R2 API Tokens
# R2_CDN_DOMAIN: R2 → Bucket → Settings → Public Access
#   e.g. pub-abc123def456.r2.dev  OR  cdn.yourdomain.com
# For local dev with MinIO:
#   R2_ENDPOINT_URL=http://localhost:9000
#   R2_CDN_DOMAIN=localhost:9000/spark
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET_NAME=spark
R2_ENDPOINT_URL=http://localhost:9000
R2_CDN_DOMAIN=localhost:9000/spark

# ── Sentry ────────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Performance ───────────────────────────────────────────────────────────────
UVICORN_WORKERS=3
