# ── Core ──────────────────────────────────────────────────────────────────────
SECRET_KEY=dev-essay-service-secret-key-replace-before-production-xxxxxxxxxx
DEBUG=True
ENVIRONMENT=development
# Includes this service's own internal Docker hostname ("essay-service")
# from day one, even though nothing calls into it internally yet as of
# Phase 1 — omitting it until it's "needed" is exactly how this platform
# already got burned once for real: auth-service and user-service both
# silently rejected every internal call with a generic 400 for this exact
# reason (2026-09-16, see PRODUCTION_CHECKLIST.md), discovered only after
# a feature that needed it shipped. Adding the hostname now costs nothing
# and removes the chance of forgetting it later under deadline pressure.
ALLOWED_HOSTS=localhost 127.0.0.1 essay-service

# ── Database (essay_db via PgBouncer, once RDS is provisioned) ─────────────────
# TEMPORARY (2026-09-19): essay_db/essay_db_user don't exist on RDS yet, so
# local dev runs this service against a dedicated local-only Postgres
# container instead — docker-compose.dev.yml overrides DB_HOST to
# "essay-postgres" for essay-service/essay-worker/essay-beat specifically,
# and that override wins whenever this runs under docker-compose. Nothing
# else on the platform is affected: pgbouncer and the other 7 services are
# untouched. The value below is the real target this switches back to once
# RDS is ready — see LIVETRACKER3_V1.md Phase 1 notes.
DB_NAME=essay_db
DB_USER=essay_db_user
DB_PASSWORD=essay_dev_password_2024
DB_HOST=pgbouncer
DB_PORT=5432

# ── Redis (also the Celery broker/result-backend — see core/celery.py) ────────
REDIS_URL=redis://redis:6379/0

# ── JWT ───────────────────────────────────────────────────────────────────────
# SAME value across ALL services on this platform
JWT_SIGNING_KEY=dev-jwt-key-32-chars-minimum-length-ok

# ── SERVICE_KEY (shared secret for internal X-Service-Key calls) ──────────────
# Not required yet — essay-service neither calls nor is called by another
# service internally as of Phase 1. If a future phase adds such a call
# (mirroring user-service -> auth-service's pattern), add SERVICE_KEY here
# AND document it in this service's own required-vars list in
# infra/scripts/validate-env.sh at the same time — a real, already-fixed
# bug on this platform (2026-09-16) was auth-service's SERVICE_KEY being
# left unset in production because it was never documented here in the
# first place, silently making every internal call fail permission checks
# rather than actually authenticating them.
# SERVICE_KEY=

# ── Storage ───────────────────────────────────────────────────────────────────
# Deliberately absent. docs/adr/002-essay-service-architecture.md Decision 5:
# essay-service handles plain text only (no audio/image/document upload
# anywhere in scope) — wiring S3/ClamAV credentials into a service that will
# never receive a byte of binary content is exactly the over-engineering
# this project's own conventions warn against. If a future phase genuinely
# adds file upload, add the real AWS_*/CLAMAV_* vars here then, following
# assessment-service's/resource-service's existing pattern as the template.

# ── LLM (OpenAI) — Phase 5 ───────────────────────────────────────────────────
# Comma-separated, rotated across for quota headroom (essays/quota_tracker.py).
# Left empty in dev/test: every test mocks essays.llm_client.call_openai_evaluate,
# so no real key is needed to build or test this pipeline. docs/adr/004-essay-
# service-capacity-plan.md Section 3 has a named, blocking prerequisite (a
# real OpenAI account tier must be provisioned, and its actual RPM/TPM
# limits substituted into OPENAI_QUOTA_* below) before this goes anywhere
# near production — still open as of Phase 5's own implementation.
# OPENAI_API_KEYS=
OPENAI_MODEL=gpt-4o
# CLAP's own verified numbers (essays/quota_tracker.py's docstring) — a
# placeholder pending the real tier above, not this platform's own limits.
# OPENAI_QUOTA_RPM_LIMIT=500  # Tier 1 (the shared CLAP/SPARK account)
# OPENAI_QUOTA_RPD_LIMIT=10000
# OPENAI_QUOTA_TPM_LIMIT=800000
# OPENAI_QUOTA_TPD_LIMIT=10000000
# OPENAI_QUOTA_SAFETY_MARGIN=0.90

# ── Text-Similarity / Plagiarism (Task 5.4) ────────────────────────────────
# Share of a student's 5-word runs also found in a peer's essay (0.30 default;
# see core/settings.py's own comment for the measured reasoning).
# ESSAY_TEXT_SIMILARITY_THRESHOLD=0.30
# ESSAY_TEXT_SIMILARITY_MIN_LENGTH=50

# ── Email Delivery (Phase 11, Tasks 11.1/11.2 — report delivery) ───────────
# Mirrors user-service's own SMTP config verbatim (the only real SMTP
# precedent on this platform) rather than notification-service, which has
# no email-sending capability at all (verified directly against its code —
# see core/settings.py's own comment on this). Left empty in dev/test:
# test_settings.py switches EMAIL_BACKEND to Django's locmem backend, so no
# real SMTP credentials are needed to build or test the report-email flow.
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# Defaults to EMAIL_HOST_USER if unset — override only if report emails
# should show a different "From" than the SMTP login account itself.
# DEFAULT_FROM_EMAIL=

# ── Notifications Module (Phase 13, Task 13.1) — pipeline-health alerts ────
# Same env var name as user-service's own dead-letter outbox alerts (see
# core/settings.py's own comment for why a static list, not a dynamic
# super-admin lookup). Left empty in dev/test: the daily summary task
# no-ops when this is unset, so no real recipients are needed to build or
# test the alert-generation logic itself.
# ALERT_EMAIL_RECIPIENTS=
# PIPELINE_DAILY_SUMMARY_HOUR_UTC=6
# PIPELINE_ALERT_DLQ_UNRESOLVED_P1=25
# PIPELINE_ALERT_DLQ_UNRESOLVED_P2=5
# PIPELINE_ALERT_DLQ_OLDEST_AGE_P1_MINUTES=180
# PIPELINE_ALERT_DLQ_OLDEST_AGE_P2_MINUTES=45
# PIPELINE_ALERT_FAILURE_EVENTS_P2=15
# PIPELINE_ALERT_UNDISPATCHED_AGE_P1_MINUTES=30
# PIPELINE_ALERT_UNDISPATCHED_AGE_P2_MINUTES=10
# PIPELINE_SUMMARY_DEFAULT_WINDOW_HOURS=24

# ── Sentry ────────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Performance ───────────────────────────────────────────────────────────────
UVICORN_WORKERS=3

# ── Platform wiring and tuning (added during the Phase 19 documentation pass) ──
# CELERY_VISIBILITY_TIMEOUT_SECONDS=600
# CONN_MAX_AGE=0
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# PIPELINE_SUMMARY_MAX_WINDOW_HOURS=8760
# USER_SERVICE_URL=http://user-service:8000
# USER_SERVICE_TIMEOUT=3
# USER_SERVICE_RETRIES=2
# USER_SERVICE_RETRY_BACKOFF=0.3
