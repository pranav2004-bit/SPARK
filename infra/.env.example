# ── Docker Compose level variables ────────────────────────────────────────────
# Copy this to infra/.env and fill in values before running docker-compose up

# PostgreSQL superuser (used only to create per-service databases and users in Task 5.1)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Git SHA for Docker image tagging in CI/CD (set automatically by CI pipeline)
GIT_SHA=local

# Container registry for CI/CD image pushes
REGISTRY=ghcr.io/your-org/spark
