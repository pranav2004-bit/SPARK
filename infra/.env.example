# ── Docker Compose / Infrastructure ───────────────────────────────────────────
# Copy this file to infra/.env before running docker-compose up

# PostgreSQL superuser — used only to create per-service databases and users on first boot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev_password

# Per-service DB passwords for the db-backup container (infra/scripts/backup.sh) —
# must match each service's own DB_PASSWORD in services/<name>/.env exactly, or
# that database's nightly backup will fail authentication silently until someone
# checks backup.log. Added during Phase 15's production-readiness pass, when
# db-backup was found missing from docker-compose.prod.yml entirely.
AUTH_DB_PASSWORD=
USER_DB_PASSWORD=
RESOURCE_DB_PASSWORD=
PRACTICE_DB_PASSWORD=
NOTIFICATION_DB_PASSWORD=
ANALYTICS_DB_PASSWORD=
ASSESSMENT_DB_PASSWORD=

# Git SHA for Docker image tagging (set automatically by CI pipeline; leave as "local" for manual deploy)
GIT_SHA=local

# Container registry for CI/CD image pushes
# Example: ghcr.io/your-org/spark
REGISTRY=ghcr.io/your-org/spark
