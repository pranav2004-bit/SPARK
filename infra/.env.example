# ── Docker Compose / Infrastructure ───────────────────────────────────────────
# Copy this file to infra/.env before running docker-compose up

# POSTGRES_USER/POSTGRES_PASSWORD and the 7 per-service *_DB_PASSWORD vars for
# db-backup were removed 2026-09-12 — the local postgres and db-backup
# containers they belonged to are gone (database is real AWS RDS now, which
# provides its own automated backups). See PRODUCTION_CHECKLIST.md's "Items
# Added During Development" for the full migration record.

# Git SHA for Docker image tagging (set automatically by CI pipeline; leave as "local" for manual deploy)
GIT_SHA=local

# Container registry for CI/CD image pushes
# Example: ghcr.io/your-org/spark
REGISTRY=ghcr.io/your-org/spark
