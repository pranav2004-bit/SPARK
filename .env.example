# ── Django ─────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=
DJANGO_SETTINGS_MODULE=aptlogic.settings.development
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Cloudflare R2 + CDN ────────────────────────────────────────────────────────
# R2_ACCOUNT_ID: found in Cloudflare dashboard → R2 overview (right sidebar)
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY: R2 → Manage R2 API Tokens
# R2_CDN_DOMAIN: bucket's public domain (R2 → Bucket → Settings → Public Access)
#   e.g. pub-abc123def456.r2.dev  OR  cdn.aptlogic.com (custom domain)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=aptlogic
R2_CDN_DOMAIN=

# ── Next.js ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost/api

# ── Sentry ─────────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Email (production only) ────────────────────────────────────────────────────
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
