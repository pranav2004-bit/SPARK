# ── Environment files ──────────────────────────────────────────────────────────
.env
.env.*
!.env.example
.env.local
.env.*.local

# ── Python ─────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
# NOTE: bare "lib/" and "lib64/" (unanchored Python-venv-lib boilerplate)
# were removed here — this repo has no in-tree venvs (Python services run
# via Docker), so they protected nothing, and being unanchored they matched
# ANY directory named "lib" anywhere in the monorepo — including
# frontend/src/lib/, silently excluding real app source from git for an
# unknown period. .venv/, venv/, and ENV/ below already ignore whole
# virtualenv directories regardless of their internal structure, so nothing
# is lost by removing the bare lib/lib64 rules. If a future Python build
# step needs its own lib/ ignored, anchor it to a specific path
# (e.g. "services/x-service/build/lib/"), never a bare name.
.venv/
venv/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.log

# Django
*.sqlite3
staticfiles/
media/

# ── Node ───────────────────────────────────────────────────────────────────────
node_modules/
.next/
out/
.npm
.yarn-integrity
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Docker ─────────────────────────────────────────────────────────────────────
